{
  "name": "splendor-marvel",
  "version": "1.0.0",
  "description": "Splendor: Marvel — Real-Time Multiplayer & Solo Infinity Gauntlet Board Game",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,yellow\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "typescript": "^5.3.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "ts-node-dev": "^2.0.0"
  }
}